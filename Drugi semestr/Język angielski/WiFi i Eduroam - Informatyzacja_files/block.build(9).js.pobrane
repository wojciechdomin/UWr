/***/ (function(module, exports) {

var el = wp.element.createElement;

wp.blocks.registerBlockType('bonasoft-modular/bona-news-two-columns', {
    title: 'Aktualności 5',
    icon: 'format-gallery',
    category: 'common',
    attributes: {
        title: {
            type: 'string'
        },
        css_class: {
            type: 'string'
        },
        category: {
            type: 'string'
        }
    },
    edit(props) {

        var title = props.attributes.title;
        var css_class = props.attributes.css_class;
        var category = props.attributes.category;

        //var postCat = wp.data.select('core').getEntityRecords('taxonomy', 'aktualnosc_new', {per_page: -1});

        function onChangeTitle(content) {
            props.setAttributes({ title: event.target.value });
        }

        function onChangeCssClass(content) {
            props.setAttributes({ css_class: event.target.value });
        }

        function onChangeCategory(content) {
            props.setAttributes({ category: event.target.value });
        }

        function updateType(event) {
            props.setAttributes({ type: event.target.value });
        }

        return el('div', {
            className: 'bona-news-two-columns'
        }, el('h3', {
            className: 'bona-news-two-columns-h'
        }, 'Aktualności 5'), el('span', {}, 'Tytuł Bloku: '), el('input', {
            type: 'text',
            placeholder: 'Enter title here...',
            value: title,
            onChange: onChangeTitle,
            style: { width: '100%' }
        }), el('span', {}, 'Klasa Css: '), el('input', {
            type: 'text',
            placeholder: 'Enter title here...',
            value: css_class,
            onChange: onChangeCssClass,
            style: { width: '100%' }
        }), el('span', {}, 'Kategoria: '), el('input', {
            type: 'text',
            placeholder: 'Enter title here...',
            value: category,
            onChange: onChangeCategory,
            style: { width: '100%' }
        }));
    },
    save(props) {
        return null;
    }
});

