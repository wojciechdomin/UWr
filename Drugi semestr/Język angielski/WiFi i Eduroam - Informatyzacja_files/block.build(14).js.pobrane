/***/ (function(module, exports) {

var el = wp.element.createElement;

wp.blocks.registerBlockType("bonasoft-modular/bona-baner-slajd", {
  title: "Baner tekstowy",
  icon: "format-gallery",
  category: "common",
  attributes: {
    title: {
      type: "string"
    },
    title2: {
      type: "string"
    },
    title3: {
      type: "string"
    }
  },

  edit(props) {
    const { title, title2, title3 } = props.attributes;

    function onChangeTitle(newTitle) {
      props.setAttributes({ title: newTitle });
    }
    function onChangeTitle2(newTitle) {
      props.setAttributes({ title2: newTitle });
    }
    function onChangeTitle3(newTitle) {
      props.setAttributes({ title3: newTitle });
    }

    return el("div", {
      className: "bona-wydarzenia"
    }, el("h3", {
      className: "bona-wydarzenia-h"
    }, "Blok z tekstami"), el("span", {}, "Pierwszy tekst: "), el("input", {
      type: "text",
      placeholder: "wpisz tutaj tekst...",
      value: title,
      onChange: e => onChangeTitle(e.target.value),
      style: { width: "100%" }
    }), el("span", {}, "Drugi tekst: "), el("input", {
      type: "text",
      placeholder: "wpisz tutaj tekst...",
      value: title2,
      onChange: e => onChangeTitle2(e.target.value),
      style: { width: "100%" }
    }), el("span", {}, "Trzeci tekst: "), el("input", {
      type: "text",
      placeholder: "wpisz tutaj tekst...",
      value: title3,
      onChange: e => onChangeTitle3(e.target.value),
      style: { width: "100%" }
    }));
  },
  save(props) {
    return null;
  }
});

