/**
 * SECTION pagination
 * Add title to pagination
 */
(() => {
  const paginations = document.querySelectorAll(
    ".ast-pagination .page-numbers"
  );
  if (paginations) {
    paginations.forEach((pagination) => {
      const number = pagination.textContent;
      pagination.setAttribute("title", `Przejdź do strony ${number}`);
    });
  }
  const next = document.querySelector(".next.page-numbers");
  if (next) {
    next.setAttribute("title", `Przejdź do następnej strony`);
  }
  const nextBtn = document.querySelector("form#goToPageForm button");
  if (nextBtn) {
    nextBtn.setAttribute("title", `Przejdź przycisk`);
  }

  const anotherPaginations = document.querySelectorAll(
    ".pagination-numbers .page-numbers"
  );
  if (anotherPaginations) {
    anotherPaginations.forEach((pagination) => {
      const number = pagination.textContent;
      pagination.setAttribute("title", `Przejdź do strony ${number}`);
    });
  }
  const page_number = document.querySelector("#page_number");
  if (page_number) {
    page_number.setAttribute("title", `Przejdź do strony`);
  }
})();
// !SECTION

/**
 * SECTION pagination
 * Add title to pagination
 */
(() => {
  const attachments = document.querySelectorAll(".files-list .delete-file");
  if (!attachments) return;
  attachments.forEach((attachment) => {
    attachment.setAttribute("tabindex", "0");
    attachment.addEventListener("keydown", (e) => {
      if (e.key == "Enter") {
        attachment.click();
      }
    });
  });
})();
// !SECTION

/**
 * SECTION pagination
 * mobile menu recreate view
 */
(() => {
  const elements = document.querySelectorAll(
    "#ast-hf-mobile-menu li.menu-item.menu-item-type-custom.menu-item-has-children"
  );

  elements.forEach((element) => {
    const link = element.querySelector("a.menu-link");
    const button = element.querySelector("button.ast-menu-toggle");
    const text = link.innerHTML;
    const title = link.getAttribute("title");
    const p = document.createElement("p");
    p.classList.add("bs-list-element-name");
    p.innerHTML = text;
    if (button) {
      button.setAttribute("title", `${title}`);
      button.prepend(p);
    }

    link.remove();
  });

})();
// !SECTION

/**
 * SECTION form checkbox
 */
(() => {
  const checkbox = document.querySelector(
    ".checkbox-cover input"
  );
  if (!checkbox) return;
  checkbox.addEventListener("keydown", (e) => {
    if (e.key == "Enter") {
      checkbox.click();
    }
  })

  const singleCards = document.querySelectorAll(".single-article-img a");
  if (singleCards) {
    singleCards.forEach((singleCard) => {
      singleCard.setAttribute("tabindex", "-1");
    })
  }
})();
// !SECTION

function setTabindexForm() {
  const startForm = document.querySelector("form .ui-tabs-tab.ui-corner-top");
  if (startForm) {
    startForm.setAttribute("tabindex", "-1");
  }
}

setTimeout(setTabindexForm, 6000);



(() => {
  function setTabindexBreadcrumbs() {
    const breadcrumbs = document.querySelectorAll(
      ".bs_breadcrumb_trail a"
    );
    breadcrumbs.forEach((bredcrumb) => {
      if (breadcrumbs[breadcrumbs.length - 1] == bredcrumb) {
        bredcrumb.setAttribute("tabindex", "-1");
        bredcrumb.style.color = "gray";
        bredcrumb.style.pointerEvents = "none";
      } else {
        bredcrumb.setAttribute("tabindex", "0");
      }
    });
  }
  setTimeout(setTabindexBreadcrumbs, 1000);

})();

